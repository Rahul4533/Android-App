rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCustomer(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.photoBase64 is string && data.photoBase64.size() <= 60000 &&
             data.netBalance is int && data.netBalance >= -10000000 && data.netBalance <= 10000000 &&
             data.totalUdhar is int && data.totalUdhar >= 0 && data.totalUdhar <= 100000000 &&
             data.totalJama is int && data.totalJama >= 0 && data.totalJama <= 100000000 &&
             data.lastItemsSummary is string && data.lastItemsSummary.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.customerId is string && isValidId(data.customerId) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             data.type is string && (data.type == 'UDHAR' || data.type == 'JAMA') &&
             data.amount is int && data.amount >= 1 && data.amount <= 1000000 &&
             data.items is list && data.items.size() <= 15 &&
             (data.items.size() == 0 || (data.items[0] is string && data.items[0].size() <= 50)) &&
             data.note is string && data.note.size() <= 200 &&
             data.photoBase64 is string && data.photoBase64.size() <= 60000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/customers/{customerId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(customerId) &&
                    request.auth.uid == userId;

      allow list: if isSignedIn() &&
                     request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(customerId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'name', 'phone', 'photoBase64', 'netBalance', 'totalUdhar', 'totalJama', 'lastItemsSummary', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'phone', 'photoBase64', 'netBalance', 'totalUdhar', 'totalJama', 'lastItemsSummary', 'createdAt', 'updatedAt']) &&
                       isValidCustomer(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(customerId) &&
                       request.auth.uid == userId &&
                       isValidCustomer(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'photoBase64', 'netBalance', 'totalUdhar', 'totalJama', 'lastItemsSummary', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(customerId) &&
                       request.auth.uid == userId;
    }

    match /users/{userId}/transactions/{transactionId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(transactionId) &&
                    request.auth.uid == userId;

      allow list: if isSignedIn() &&
                     request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(transactionId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'customerId', 'customerName', 'type', 'amount', 'items', 'note', 'photoBase64', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'customerId', 'customerName', 'type', 'amount', 'items', 'note', 'photoBase64', 'createdAt', 'updatedAt']) &&
                       isValidTransaction(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(transactionId) &&
                       request.auth.uid == userId &&
                       isValidTransaction(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['customerName', 'type', 'amount', 'items', 'note', 'photoBase64', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(transactionId) &&
                       request.auth.uid == userId;
    }
  }
}
